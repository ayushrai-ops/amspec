# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://amspec:amspec_secret_2024@localhost:5432/amspec_db

# JWT
JWT_SECRET=amspec-jwt-secret-change-in-production-abc123
JWT_REFRESH_SECRET=amspec-refresh-secret-change-in-production-xyz789
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@amspec.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Upload Directory
UPLOAD_DIR=../uploads
